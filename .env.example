# ─────────────────────────────────────────────────────────────────────────────
# Jarvis — Environment Variables
# Copy this file to .env and fill in your own keys.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Model (Required) ───────────────────────────────────────────────────────
# Get a free key at: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here

# Optional: override the default model (meta/llama-3.3-70b-instruct)
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ── Weather (Required) ────────────────────────────────────────────────────────
# Free tier available at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweathermap-key-here

# ── Text-to-Speech (Required) ─────────────────────────────────────────────────
# Free tier available at: https://elevenlabs.io
# If this key hits rate limits, the app auto-falls-back to Edge TTS (free).
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# ── Web Search (Optional) ─────────────────────────────────────────────────────
# Enables the "search Google" capability.
# API key: https://console.cloud.google.com  (Custom Search API)
# CX ID:   https://programmablesearchengine.google.com
GOOGLE_CSE_API_KEY=your-google-cse-api-key-here
GOOGLE_CSE_CX=your-search-engine-cx-id-here

# ── Wake Word (Optional) ──────────────────────────────────────────────────────
# Enables "Hey Jarvis" detection via Picovoice Porcupine.
# Free key at: https://console.picovoice.ai
# PICOVOICE_ACCESS_KEY=your-picovoice-key-here
